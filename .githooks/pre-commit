#!/bin/bash
set -e

# Detect staged plugin content changes (exclude plugin.json itself)
PLUGIN_CHANGES=$(git diff --cached --name-only -- \
  'commands/' 'agents/' 'knowledge/' 'templates/' \
  'CLAUDE.md' 'README.md' \
  | grep -v 'plugin.json' || true)

if [ -z "$PLUGIN_CHANGES" ]; then
    exit 0
fi

PLUGIN_JSON="plugin.json"

if [ ! -f "$PLUGIN_JSON" ]; then
    echo "Warning: plugin.json not found, skipping auto-bump"
    exit 0
fi

CURRENT_VERSION=$(grep -o '"version": "[^"]*"' "$PLUGIN_JSON" | head -1 | sed 's/"version": "\([^"]*\)"/\1/')

if [ -z "$CURRENT_VERSION" ]; then
    echo "Warning: Could not extract version, skipping auto-bump"
    exit 0
fi

MAJOR=$(echo "$CURRENT_VERSION" | cut -d. -f1)
MINOR=$(echo "$CURRENT_VERSION" | cut -d. -f2)
PATCH=$(echo "$CURRENT_VERSION" | cut -d. -f3)

NEW_PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${NEW_PATCH}"

echo "Auto-bumping version: $CURRENT_VERSION -> $NEW_VERSION"

sed -i '' "s/\"version\": \"$CURRENT_VERSION\"/\"version\": \"$NEW_VERSION\"/" "$PLUGIN_JSON"

git add "$PLUGIN_JSON"

echo "Version files updated and staged"
